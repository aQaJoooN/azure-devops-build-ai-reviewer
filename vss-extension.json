{
  "manifestVersion": 1,
  "id": "ai-analyzer",
  "name": "AI Analyzer for Build Logs",
  "publisher": "aQaJoooN",
  "public": true,
  "description": "AI-powered build log analysis extension for Azure DevOps. Analyze build failures with AI assistance.",
  "categories": [
    "Azure Pipelines"
  ],
  "tags": [
    "AI",
    "Build",
    "Analysis",
    "Logs",
    "DevOps"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "icons": {
    "default": "images/logo.png"
  },
  "content": {
    "details": {
      "path": "README.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "links": {
    "support": {
      "uri": "https://github.com/aQaJoooN/azure-devops-build-ai-reviewer/issues"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/aQaJoooN/azure-devops-build-ai-reviewer"
  },
  "scopes": [
    "vso.build",
    "vso.code",
    "vso.project",
    "vso.serviceendpoint_manage"
  ],
  "contributions": [
    {
      "id": "settings",
      "type": "ms.vss-web.hub",
      "description": "AI Analyzer extension settings page",
      "targets": [
        "ms.vss-web.project-admin-hub-group"
      ],
      "properties": {
        "name": "AI Analyzer Settings",
        "uri": "dist/settings.html",
        "icon": "images/settings-icon.png",
        "order": 100
      }
    },
    {
      "id": "tab",
      "type": "ms.vss-build-web.build-results-tab",
      "description": "AI-powered build log analysis tab",
      "targets": [
        "ms.vss-build-web.build-results-view"
      ],
      "properties": {
        "name": "AI Analyzer",
        "uri": "dist/analyzer-tab.html",
        "order": 50
      }
    }
  ],
  "files": [
    {
      "path": "LICENSE",
      "addressable": true
    },
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "images",
      "addressable": true
    }
  ]
}